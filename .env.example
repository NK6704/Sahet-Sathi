# =====================================================================
# Sehat Sathi — environment template
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is
# the only one that is committed, so it must never contain a real value.
# =====================================================================

# --- Supabase --------------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
#
# The publishable (formerly "anon") key is meant to be public — Row Level
# Security is what protects the data, so it is safe in the browser
# bundle. Newer projects issue it as sb_publishable_…; older ones as a
# long JWT. Either works.
SUPABASE_URL=
VITE_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Server-side only. This key bypasses every RLS policy, so it must never
# be given a VITE_ prefix — that would ship it to the browser and make
# the entire database readable by anyone who opens devtools.
SUPABASE_SECRET_KEY=

# Public signing keys. Lets the server verify a session token in-process
# rather than calling the Auth API once per request. Defaults to
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json when left blank.
SUPABASE_JWKS_URL=

# --- Google Gemini ---------------------------------------------------
# Two keys, deliberately. GEMINI_API_KEY drives the text assistant and
# the Live voice session; GEMINI_PRESCRIPTION_API_KEY drives prescription
# reading. Separating them stops one feature's quota from starving the
# other. If the second is blank the first is used for both.
GEMINI_API_KEY=
GEMINI_PRESCRIPTION_API_KEY=

# --- Twilio (SOS SMS) ------------------------------------------------
# All four are needed before a message can be sent:
#   - TWILIO_ACCOUNT_SID   the AC… id on the console home page
#   - the API key pair     an SK… SID and its secret
#   - a sender             either a purchased number or a Messaging
#                          Service SID
#
# With any of them missing, SOS degrades honestly: the in-app alert still
# reaches the ASHA worker, and each intended SMS recipient still gets a
# delivery row recorded as 'skipped' with the reason. Nothing is silently
# dropped.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# --- App -------------------------------------------------------------
# Where this app is hosted. Used for self-referential links.
APP_URL=http://localhost:3000
