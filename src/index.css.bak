@import "tailwindcss";

@layer base {
  :root {
    --background: 43 47% 95%;
    --foreground: 176 29% 17%;
    --border: 40 21% 84%;
    --input: 40 21% 84%;
    --ring: 172 40% 38%;
    --card: 44 45% 98%;
    --card-foreground: 176 29% 17%;
    --card-border: 40 23% 87%;
    --popover: 44 45% 98%;
    --popover-foreground: 176 29% 17%;
    --popover-border: 40 23% 87%;
    --primary: 172 41% 31%;
    --primary-foreground: 45 44% 97%;
    --secondary: 35 55% 88%;
    --secondary-foreground: 176 29% 17%;
    --muted: 42 28% 91%;
    --muted-foreground: 176 12% 41%;
    --accent: 19 76% 57%;
    --accent-foreground: 44 45% 98%;
    --destructive: 1 64% 45%;
    --destructive-foreground: 45 44% 97%;
    --app-font-sans: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --app-font-serif: 'Fraunces', Georgia, serif;
    --app-font-mono: 'DM Sans', sans-serif;
    --radius: 1rem;
    --shadow-soft: 0 16px 45px hsl(172 30% 22% / 0.08);
    --shadow-lift: 0 18px 35px hsl(172 30% 22% / 0.14);
  }

  .dark {
    --background: 176 28% 11%;
    --foreground: 43 47% 95%;
    --border: 176 16% 26%;
    --input: 176 16% 26%;
    --ring: 35 72% 63%;
    --card: 176 23% 15%;
    --card-foreground: 43 47% 95%;
    --card-border: 176 16% 26%;
    --popover: 176 23% 15%;
    --popover-foreground: 43 47% 95%;
    --popover-border: 176 16% 26%;
    --primary: 35 72% 63%;
    --primary-foreground: 176 28% 11%;
    --secondary: 176 18% 24%;
    --secondary-foreground: 43 47% 95%;
    --muted: 176 18% 21%;
    --muted-foreground: 43 15% 71%;
    --accent: 19 76% 60%;
    --accent-foreground: 176 28% 11%;
    --destructive: 1 64% 55%;
    --destructive-foreground: 45 44% 97%;
  }

  * {
    border-color: hsl(var(--border));
  }

  html {
    background-color: hsl(var(--background));
  }

  body {
    background-color: hsl(var(--background));
    font-family: var(--app-font-sans);
    color: hsl(var(--foreground));
    min-width: 320px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  button, a, select {
    -webkit-tap-highlight-color: transparent;
  }
}

.font-display {
  font-family: var(--app-font-serif);
}

.text-balance {
  text-wrap: balance;
}

.app-shell {
  background: radial-gradient(circle at 86% 4%, hsl(35 75% 72% / 0.20), transparent 24rem),
              radial-gradient(circle at 8% 27%, hsl(172 40% 64% / 0.10), transparent 28rem),
              hsl(var(--background));
}

.paper-grain {
  position: relative;
  isolation: isolate;
}

.paper-grain::after {
  content: '';
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  opacity: .16;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.78' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.18'/%3E%3C/svg%3E");
}

.lift-card {
  box-shadow: var(--shadow-soft);
  transition: transform .22s ease, box-shadow .22s ease;
}

.lift-card:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-lift);
}

.appear {
  animation: appear .45s ease both;
}

.appear-delay-1 {
  animation-delay: .07s;
}

.appear-delay-2 {
  animation-delay: .14s;
}

.appear-delay-3 {
  animation-delay: .21s;
}

@keyframes appear {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes breathe {
  0%, 100% {
    transform: scale(1);
    opacity: .4;
  }
  50% {
    transform: scale(1.12);
    opacity: .85;
  }
}

@keyframes listen {
  0%, 100% {
    box-shadow: 0 0 0 0 hsl(19 76% 57% / .35), 0 16px 24px hsl(172 30% 22% / .14);
  }
  50% {
    box-shadow: 0 0 0 18px hsl(19 76% 57% / 0), 0 20px 30px hsl(172 30% 22% / .20);
  }
}

.voice-ring {
  animation: listen 1.65s ease-in-out infinite;
}

.voice-ring::before {
  content: '';
  position: absolute;
  inset: -15px;
  border: 1px solid hsl(19 76% 57% / .28);
  border-radius: 999px;
  animation: breathe 1.65s ease-in-out infinite;
}

.safe-area-bottom {
  padding-bottom: max(1rem, env(safe-area-inset-bottom));
}

@media (min-width: 768px) {
  .desktop-content {
    max-width: 1160px;
    margin-inline: auto;
  }
}
/* =========================================================
   LANDING PAGE
   ========================================================= */

.landing-page {
  min-height: 100vh;

  background:
    radial-gradient(
      circle at 78% 18%,
      hsl(35 75% 72% / 0.24),
      transparent 25rem
    ),
    radial-gradient(
      circle at 12% 45%,
      hsl(172 40% 64% / 0.12),
      transparent 28rem
    ),
    hsl(var(--background));
}

.landing-title {
  color: hsl(var(--foreground));
}

.landing-highlight {
  position: relative;
  display: inline-block;
  color: hsl(var(--primary));
}

.landing-highlight::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -0.08em;
  height: 0.08em;
  background: hsl(var(--accent));
  transform: rotate(-1.5deg);
  transform-origin: left;
}


/* =========================================================
   LANGUAGE SELECTOR
   ========================================================= */

.landing-language {
  border: 0;
  background: transparent;
  padding: 0;
  color: hsl(var(--muted-foreground));
  font-size: 0.8rem;
  font-weight: 700;
  cursor: pointer;

  transition:
    color 180ms ease,
    transform 180ms ease;
}

.landing-language span {
  margin-left: 0.15rem;
  opacity: 0.55;
  font-size: 0.68rem;
}

.landing-language:hover {
  color: hsl(var(--foreground));
  transform: translateY(-1px);
}

.landing-language-active {
  color: hsl(var(--primary));
}


/* =========================================================
   BUTTONS
   ========================================================= */

.landing-primary-btn,
.landing-secondary-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;

  min-height: 3.25rem;
  padding: 0 1.4rem;

  border-radius: 999px;

  font-size: 0.82rem;
  font-weight: 800;

  transition:
    transform 220ms ease,
    background 220ms ease,
    border-color 220ms ease;
}

.landing-primary-btn {
  background: hsl(var(--primary));
  color: hsl(var(--primary-foreground));
  border: 1px solid hsl(var(--primary));
}

.landing-primary-btn:hover {
  transform: translateY(-3px);
}

.landing-secondary-btn {
  background: transparent;
  color: hsl(var(--foreground));
  border: 1px solid hsl(var(--border));
}

.landing-secondary-btn:hover {
  transform: translateY(-3px);
  border-color: hsl(var(--foreground));
}


/* =========================================================
   VOICE VISUAL
   ========================================================= */

.landing-visual {
  position: relative;

  min-height: 520px;

  display: grid;
  place-items: center;
}

.landing-orbit {
  position: absolute;

  border: 1px solid hsl(var(--primary) / 0.14);
  border-radius: 999px;

  pointer-events: none;
}

.landing-orbit-one {
  width: 390px;
  height: 390px;

  animation:
    landing-orbit 12s linear infinite;
}

.landing-orbit-two {
  width: 500px;
  height: 500px;

  border-color: hsl(var(--accent) / 0.12);

  animation:
    landing-orbit-reverse 18s linear infinite;
}


/* =========================================================
   MAIN VOICE CARD
   ========================================================= */

.landing-voice-core {
  position: relative;
  z-index: 2;

  width: min(100%, 390px);
  min-height: 430px;

  padding: 2.5rem;

  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;

  border-radius: 2rem;

  background: hsl(var(--primary));
  color: hsl(var(--primary-foreground));

  box-shadow:
    0 30px 80px hsl(var(--primary) / 0.2);

  transform: rotate(1.5deg);

  transition:
    transform 400ms ease,
    box-shadow 400ms ease;
}

.landing-voice-core:hover {
  transform: rotate(0deg) translateY(-6px);

  box-shadow:
    0 40px 100px hsl(var(--primary) / 0.26);
}


/* Microphone circle */

.landing-voice-icon {
  width: 58px;
  height: 58px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  background: hsl(var(--accent));
  color: white;

  margin-bottom: 1.5rem;
}


/* Small label */

.landing-live-label {
  font-size: 0.65rem;
  font-weight: 800;

  letter-spacing: 0.18em;
  text-transform: uppercase;

  opacity: 0.7;
}


/* Voice heading */

.landing-voice-core h2 {
  margin-top: 1rem;

  max-width: 320px;

  font-family: var(--app-font-serif);

  font-size: clamp(2rem, 4vw, 3rem);

  line-height: 0.98;

  letter-spacing: -0.04em;
}


/* Voice description */

.landing-voice-core p {
  margin-top: 1rem;

  max-width: 300px;

  font-size: 0.8rem;

  line-height: 1.7;

  opacity: 0.75;
}


/* Circle CTA */

.landing-circle-action {
  width: 56px;
  height: 56px;

  display: grid;
  place-items: center;

  margin-top: 2rem;

  border: 1px solid hsl(var(--primary-foreground) / 0.3);

  border-radius: 50%;

  background: hsl(var(--primary-foreground) / 0.1);

  color: inherit;

  cursor: pointer;

  transition:
    transform 220ms ease,
    background 220ms ease;
}

.landing-circle-action:hover {
  transform: scale(1.08);

  background:
    hsl(var(--primary-foreground) / 0.18);
}


/* =========================================================
   SERVICE STRIP
   ========================================================= */

.landing-services {
  border-color: hsl(var(--border));
}

.landing-service {
  min-height: 72px;

  display: flex;
  align-items: center;

  gap: 0.65rem;

  padding: 1rem 0;

  color: hsl(var(--muted-foreground));

  font-size: 0.72rem;
  font-weight: 700;
}

.landing-service + .landing-service {
  border-top: 1px solid hsl(var(--border));
}


/* =========================================================
   DESKTOP SERVICE STRIP
   ========================================================= */

@media (min-width: 640px) {

  .landing-service {
    padding-right: 1.25rem;
  }

  .landing-service + .landing-service {
    border-top: 0;

    border-left:
      1px solid hsl(var(--border));

    padding-left: 1.25rem;
  }
}


/* =========================================================
   ANIMATION
   ========================================================= */

@keyframes landing-orbit {

  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }

}

@keyframes landing-orbit-reverse {

  from {
    transform: rotate(360deg);
  }

  to {
    transform: rotate(0deg);
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 639px) {

  .landing-hero {
    min-height: auto;
  }

  .landing-visual {
    min-height: 400px;
    margin-top: 1rem;
  }

  .landing-orbit-one {
    width: 280px;
    height: 280px;
  }

  .landing-orbit-two {
    width: 350px;
    height: 350px;
  }

  .landing-voice-core {
    min-height: 360px;
    padding: 2rem;
  }

}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  .landing-orbit-one,
  .landing-orbit-two {
    animation: none;
  }

  .landing-primary-btn,
  .landing-secondary-btn,
  .landing-voice-core,
  .landing-circle-action {
    transition: none;
  }

}

/* =========================================================
   FLOATING GLASS NAVIGATION
   ========================================================= */

.glass-nav {
  position: relative;
  overflow: hidden;

  border: 1px solid rgba(255, 255, 255, 0.65);
  border-radius: 999px;

  background: rgba(255, 255, 255, 0.68);

  backdrop-filter:
    blur(22px)
    saturate(150%);

  -webkit-backdrop-filter:
    blur(22px)
    saturate(150%);

  box-shadow:
    0 10px 35px rgba(30, 45, 40, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.8);

  transition:
    background 250ms ease,
    box-shadow 250ms ease,
    transform 250ms ease;
}


/* subtle glass highlight */

.glass-nav::before {
  content: '';

  position: absolute;
  inset: 0;

  pointer-events: none;

  border-radius: inherit;

  background:
    linear-gradient(
      110deg,
      rgba(255, 255, 255, 0.42),
      transparent 35%,
      rgba(255, 255, 255, 0.18)
    );
}


.glass-nav::after {
  content: '';

  position: absolute;
  inset: -20px;

  pointer-events: none;

  background:
    radial-gradient(
      circle at 20% 50%,
      rgba(255, 255, 255, 0.18),
      transparent 35%
    );

  filter: blur(14px);

  transform: scale(1.08);

  opacity: 0.7;
}

/* keep actual navigation above the glass */

.glass-nav > * {
  position: relative;
  z-index: 2;
}


/* Slightly stronger glass while scrolling/hovering */

.glass-nav:hover {
  background: rgba(255, 255, 255, 0.76);

  box-shadow:
    0 14px 42px rgba(30, 45, 40, 0.11),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 767px) {
  .glass-nav {
    height: 62px;
    border-radius: 999px;
  }
}